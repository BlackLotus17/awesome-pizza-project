{
    "openapi": "3.0.3",
    "info": {
        "title": "Awesome Pizza API",
        "version": "1.0.0",
        "description": "REST API for the Awesome Pizza ordering app.\n\nData is held in memory and resets when the server restarts.\nEvery response uses the envelope `{ success, data?, message?, error? }` (login also returns `token`).\n\nTo try the protected endpoints, call **POST /api/login** with `user` / `pass`,\nthen click **Authorize** and paste the returned token."
    },
    "servers": [
        {
            "url": "/",
            "description": "This server"
        }
    ],
    "tags": [
        {
            "name": "Menu",
            "description": "The daily menu"
        },
        {
            "name": "Orders",
            "description": "Create, read and update orders"
        },
        {
            "name": "Auth",
            "description": "Demo login and token-protected endpoints"
        }
    ],
    "paths": {
        "/api/daily-menu": {
            "get": {
                "tags": [
                    "Menu"
                ],
                "summary": "Get the daily menu",
                "operationId": "getDailyMenu",
                "responses": {
                    "200": {
                        "description": "The pizzas available today",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/SuccessEnvelope"
                                        },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": {
                                                    "type": "array",
                                                    "items": {
                                                        "$ref": "#/components/schemas/MenuEntry"
                                                    }
                                                }
                                            }
                                        }
                                    ]
                                },
                                "example": {
                                    "success": true,
                                    "message": "Daily menu retrieved successfully",
                                    "data": [
                                        {
                                            "name": "Margherita Pizza",
                                            "description": "Classic pizza with fresh tomatoes, mozzarella cheese, and basil",
                                            "imageUrl": "assets/origs/margherita.png"
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Unexpected server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "example": {
                                    "success": false,
                                    "error": "Internal server error",
                                    "message": "Failed to process request"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/orders": {
            "post": {
                "tags": [
                    "Orders"
                ],
                "summary": "Create an order",
                "description": "New orders always start in status `RECEIVED`. Every item must be on the daily menu.",
                "operationId": "createOrder",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateOrderRequest"
                            },
                            "example": {
                                "sender": "Alice",
                                "contents": [
                                    {
                                        "name": "Margherita Pizza",
                                        "quantity": 2
                                    },
                                    {
                                        "name": "Pepperoni Pizza",
                                        "quantity": 1
                                    }
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Order created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/OrderResponse"
                                },
                                "example": {
                                    "success": true,
                                    "message": "Order created successfully",
                                    "data": {
                                        "id": "order-1761820800000-42",
                                        "sender": "Alice",
                                        "status": "RECEIVED",
                                        "contents": [
                                            {
                                                "name": "Margherita Pizza",
                                                "quantity": 2
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid sender or contents",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "example": {
                                    "success": false,
                                    "error": "Bad request",
                                    "message": "'Hawaiian Pizza' is not on the menu"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Unexpected server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "example": {
                                    "success": false,
                                    "error": "Internal server error",
                                    "message": "Failed to process request"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/orders/{id}": {
            "parameters": [
                {
                    "name": "id",
                    "in": "path",
                    "required": true,
                    "description": "Order ID. Seed orders are `order-001` to `order-003`; new ones look like `order-<timestamp>-<random>`.",
                    "schema": {
                        "type": "string",
                        "example": "order-001"
                    }
                }
            ],
            "get": {
                "tags": [
                    "Orders"
                ],
                "summary": "Get an order by ID",
                "operationId": "getOrder",
                "responses": {
                    "200": {
                        "description": "The order",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/OrderResponse"
                                },
                                "example": {
                                    "success": true,
                                    "message": "Order retrieved successfully",
                                    "data": {
                                        "id": "order-001",
                                        "sender": "John Doe",
                                        "status": "RECEIVED",
                                        "contents": [
                                            {
                                                "name": "Margherita Pizza",
                                                "quantity": 2
                                            },
                                            {
                                                "name": "Pepperoni Pizza",
                                                "quantity": 1
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "No order has this ID",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "example": {
                                    "success": false,
                                    "error": "Not found",
                                    "message": "Order with ID 'order-999' not found"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Unexpected server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "example": {
                                    "success": false,
                                    "error": "Internal server error",
                                    "message": "Failed to process request"
                                }
                            }
                        }
                    }
                }
            },
            "put": {
                "tags": [
                    "Orders"
                ],
                "summary": "Update an order",
                "description": "Partial update: send only the fields to change.\n\nAllowed status changes (re-sending the current status is a no-op):\n- `RECEIVED` → `DELIVERING` or `CANCELED`\n- `DELIVERING` → `DELIVERED`\n- `DELIVERED` and `CANCELED` are final",
                "operationId": "updateOrder",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdateOrderRequest"
                            },
                            "examples": {
                                "status": {
                                    "summary": "Start delivery",
                                    "value": {
                                        "status": "DELIVERING"
                                    }
                                },
                                "contents": {
                                    "summary": "Change the items",
                                    "value": {
                                        "contents": [
                                            {
                                                "name": "BBQ Chicken Pizza",
                                                "quantity": 3
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Order updated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/OrderResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid sender, status or contents",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "example": {
                                    "success": false,
                                    "error": "Bad request",
                                    "message": "Status must be one of: RECEIVED, DELIVERING, DELIVERED, CANCELED"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "No order has this ID",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "example": {
                                    "success": false,
                                    "error": "Not found",
                                    "message": "Order with ID 'order-999' not found"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "Status change not allowed from the current status",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "example": {
                                    "success": false,
                                    "error": "Conflict",
                                    "message": "Cannot change status from DELIVERED to RECEIVED"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Unexpected server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "example": {
                                    "success": false,
                                    "error": "Internal server error",
                                    "message": "Failed to process request"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Log in and get a token",
                "description": "Demo credentials: `user` / `pass`.",
                "operationId": "login",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequest"
                            },
                            "example": {
                                "username": "user",
                                "password": "pass"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Logged in",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LoginResponse"
                                },
                                "example": {
                                    "success": true,
                                    "token": "eyJyb2xlIjoiYWRtaW4ifQ=="
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Wrong username or password",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "example": {
                                    "success": false,
                                    "error": "Invalid credentials"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/protected": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "Get protected staff data",
                "operationId": "getProtected",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Access granted",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/SuccessEnvelope"
                                        },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": {
                                                    "$ref": "#/components/schemas/ProtectedData"
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Missing or invalid token",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "example": {
                                    "success": false,
                                    "error": "Unauthorized",
                                    "message": "Valid token required"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/admin": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "Admin check",
                "description": "Succeeds only for the server-issued token, whose base64 payload is `{\"role\":\"admin\"}`.",
                "operationId": "getAdmin",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Caller is admin",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SuccessEnvelope"
                                },
                                "example": {
                                    "success": true,
                                    "message": "Welcome, admin!"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Missing token, or token is not valid base64 JSON",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "example": {
                                    "success": false,
                                    "error": "Unauthorized",
                                    "message": "Token required"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Token is not the server-issued admin token",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "example": {
                                    "success": false,
                                    "error": "Forbidden",
                                    "message": "Not authorised"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "description": "Token returned by POST /api/login"
            }
        },
        "schemas": {
            "OrderStatus": {
                "type": "string",
                "enum": [
                    "RECEIVED",
                    "DELIVERING",
                    "DELIVERED",
                    "CANCELED"
                ]
            },
            "OrderItem": {
                "type": "object",
                "required": [
                    "name",
                    "quantity"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Must match a daily menu entry name",
                        "example": "Margherita Pizza"
                    },
                    "quantity": {
                        "type": "integer",
                        "minimum": 1,
                        "example": 2
                    }
                }
            },
            "Order": {
                "type": "object",
                "required": [
                    "id",
                    "sender",
                    "status",
                    "contents"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "example": "order-001"
                    },
                    "sender": {
                        "type": "string",
                        "description": "Customer name",
                        "example": "John Doe"
                    },
                    "status": {
                        "$ref": "#/components/schemas/OrderStatus"
                    },
                    "contents": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/OrderItem"
                        }
                    }
                }
            },
            "MenuEntry": {
                "type": "object",
                "required": [
                    "name",
                    "description",
                    "imageUrl"
                ],
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "imageUrl": {
                        "type": "string",
                        "description": "Path relative to the UI root"
                    }
                }
            },
            "CreateOrderRequest": {
                "type": "object",
                "required": [
                    "sender",
                    "contents"
                ],
                "properties": {
                    "sender": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Customer name; trimmed"
                    },
                    "contents": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                            "$ref": "#/components/schemas/OrderItem"
                        }
                    }
                }
            },
            "UpdateOrderRequest": {
                "type": "object",
                "properties": {
                    "sender": {
                        "type": "string",
                        "minLength": 1
                    },
                    "status": {
                        "$ref": "#/components/schemas/OrderStatus"
                    },
                    "contents": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                            "$ref": "#/components/schemas/OrderItem"
                        }
                    }
                }
            },
            "LoginRequest": {
                "type": "object",
                "required": [
                    "username",
                    "password"
                ],
                "properties": {
                    "username": {
                        "type": "string"
                    },
                    "password": {
                        "type": "string",
                        "format": "password"
                    }
                }
            },
            "LoginResponse": {
                "type": "object",
                "required": [
                    "success",
                    "token"
                ],
                "properties": {
                    "success": {
                        "type": "boolean",
                        "example": true
                    },
                    "token": {
                        "type": "string"
                    }
                }
            },
            "ProtectedData": {
                "type": "object",
                "properties": {
                    "secretRecipes": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "staffDiscount": {
                        "type": "string"
                    },
                    "vipCode": {
                        "type": "string"
                    },
                    "deliveryNote": {
                        "type": "string"
                    }
                }
            },
            "SuccessEnvelope": {
                "type": "object",
                "required": [
                    "success"
                ],
                "properties": {
                    "success": {
                        "type": "boolean",
                        "example": true
                    },
                    "message": {
                        "type": "string"
                    }
                }
            },
            "OrderResponse": {
                "allOf": [
                    {
                        "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                        "type": "object",
                        "properties": {
                            "data": {
                                "$ref": "#/components/schemas/Order"
                            }
                        }
                    }
                ]
            },
            "ErrorResponse": {
                "type": "object",
                "required": [
                    "success",
                    "error"
                ],
                "properties": {
                    "success": {
                        "type": "boolean",
                        "example": false
                    },
                    "error": {
                        "type": "string"
                    },
                    "message": {
                        "type": "string"
                    }
                }
            }
        }
    }
}
