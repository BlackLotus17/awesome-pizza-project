meta {
  name: Create Order - Fractional Quantity
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/orders
  body: json
  auth: none
}

body:json {
  {
    "sender": "Bruno Tester",
    "contents": [
      {
        "name": "Margherita Pizza",
        "quantity": 1.5
      }
    ]
  }
}

assert {
  res.status: eq 400
  res.body.success: eq false
}
