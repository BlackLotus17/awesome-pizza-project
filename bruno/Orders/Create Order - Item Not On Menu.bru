meta {
  name: Create Order - Item Not On Menu
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/orders
  body: json
  auth: none
}

body:json {
  {
    "sender": "Bruno Tester",
    "contents": [
      {
        "name": "Pineapple Surprise",
        "quantity": 1
      }
    ]
  }
}

assert {
  res.status: eq 400
  res.body.success: eq false
}
