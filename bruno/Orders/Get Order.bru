meta {
  name: Get Order
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/orders/{{orderId}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

tests {
  test("returns the created order", function () {
    expect(res.getBody().data.id).to.equal(bru.getVar("orderId"));
  });
}
