meta {
  name: Get Daily Menu
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/daily-menu
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

tests {
  test("returns a non-empty menu", function () {
    const menu = res.getBody().data;
    expect(menu).to.be.an("array").that.is.not.empty;
    expect(menu[0]).to.include.keys("name", "description", "imageUrl");
  });
}
